{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ERP Boutique",
  "version": "0.1.0",
  "identifier": "ci.pcci.erp-boutique",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ERP Boutique",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon-192.png",
      "icons/icon-512.png",
      "icons/icon.ico"
    ]
  }
}
